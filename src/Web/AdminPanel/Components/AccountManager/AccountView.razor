@if (this.State.Session is { } session)
{
    <div class="account-header">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <h2 class="h4 mb-0">@session.Account.LoginName</h2>
            @if (session.State != AccountState.Normal)
            {
                <span class="badge @StateBadge(session.State)">@session.State.GetEnumCaption()</span>
            }

            @if (session.WasOnline)
            {
                <span class="badge text-bg-danger" title="@Resources.AccountManagerOnlineHint">@Resources.AccountManagerOnline</span>
            }
            else
            {
                <span class="badge text-bg-secondary">@Resources.AccountManagerOffline</span>
            }

            <span class="text-muted small">@string.Format(Resources.AccountManagerRegistered, session.Account.RegistrationDate.ToLocalTime().ToString("d"))</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="changes">
                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!session.HasChanges)" @onclick="() => this._showChanges = !this._showChanges">
                    @if (session.HasChanges)
                    {
                        <span class="badge text-bg-warning me-1">@session.PendingChanges.Count</span>
                        @Resources.AccountManagerUnsaved
                    }
                    else
                    {
                        @Resources.AccountManagerNoChanges
                    }
                </button>
                @if (this._showChanges && session.HasChanges)
                {
                    <div class="changes-popover card" @onclick="() => this._showChanges = false">
                        <div class="fw-semibold small mb-1">@Resources.AccountManagerUnsavedChanges</div>
                        <ul class="small text-muted mb-0 ps-3">
                            @foreach (var change in session.PendingChanges)
                            {
                                <li>@change</li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" title="@Resources.AccountManagerReloadHint" @onclick="this.State.ReloadAsync">@Resources.Reload</button>
            <button type="button" class="btn btn-sm btn-primary save" disabled="@(!session.HasChanges || this.State.IsBusy)" @onclick="this.State.SaveAsync">
                @if (this.State.IsBusy)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                @Resources.Save
            </button>
        </div>
    </div>

    <div class="character-bar">
        @foreach (var character in session.Characters)
        {
            <button type="button" class="character-chip @(this.State.SelectedCharacter == character ? "active" : string.Empty)" @key="character" @onclick="() => this.State.SelectCharacter(character)">
                <span class="fw-semibold">@character.Name</span>
                <span class="small opacity-75">@(character.CharacterClass?.Name.ToString()) · @character.Level</span>
            </button>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary new-character" @onclick="this.ShowNewCharacterAsync">
            <span class="oi oi-plus" aria-hidden="true"></span> @Resources.AccountManagerNewCharacter
        </button>
    </div>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button type="button" class="nav-link @(this.State.Tab == AccountTab.Items ? "active" : string.Empty)" @onclick="() => this.Set(() => this.State.Tab = AccountTab.Items)">@Resources.AccountManagerItems</button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(this.State.Tab == AccountTab.Character ? "active" : string.Empty)" @onclick="() => this.Set(() => this.State.Tab = AccountTab.Character)">@Resources.AccountManagerCharacter</button>
        </li>
        <li class="nav-item">
            <button type="button" class="nav-link @(this.State.Tab == AccountTab.Account ? "active" : string.Empty)" @onclick="() => this.Set(() => this.State.Tab = AccountTab.Account)">@Resources.AccountManagerAccount</button>
        </li>
    </ul>

    @switch (this.State.Tab)
    {
        case AccountTab.Items:
            <ItemsTab />
            break;
        case AccountTab.Character:
            <CharacterTab />
            break;
        default:
            <AccountSettingsTab />
            break;
    }
}

@code {
    private bool _showChanges;

    [Inject]
    private IModalService ModalService { get; set; } = null!;

    /// <summary>
    /// Gets the CSS class of the badge of an account state.
    /// </summary>
    /// <param name="state">The state.</param>
    /// <returns>The CSS class.</returns>
    public static string StateBadge(AccountState state) => state switch
    {
        AccountState.Banned or AccountState.TemporarilyBanned => "text-bg-danger",
        AccountState.GameMaster or AccountState.GameMasterInvisible => "text-bg-warning",
        _ => "text-bg-secondary",
    };

    private async Task ShowNewCharacterAsync()
    {
        var modal = this.ModalService.Show<NewCharacterDialog>(Resources.AccountManagerNewCharacter);
        await modal.Result.ConfigureAwait(true);
    }
}
