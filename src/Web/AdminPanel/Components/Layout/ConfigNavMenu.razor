@using MUnique.OpenMU.Web.AdminPanel.Properties

<li class="nav-item dropdown@(this._expandGameConfig ? " expanded" : "")">
    <a class="nav-link dropdown-toggle" href="" role="button" aria-haspopup="true" aria-expanded="@(this._expandGameConfig)" @onclick="ToggleGameConfig" @onclick:preventDefault="true">
        @Resources.GameConfiguration
    </a>
    <div class="dropdown-menu@(this._expandGameConfig ? " show" : "")">
        @foreach (var group in this.Groups)
        {
            var isOpen = this._openGroup == group;
            <button type="button" class="dropdown-item nav-group-toggle@(isOpen ? " expanded" : "")" aria-expanded="@isOpen"
                    @onclick="() => this.ToggleGroup(group)">
                @group.Caption()
            </button>
            @if (isOpen)
            {
                <div class="nav-group">
                    @foreach (var link in group.Links)
                    {
                        if (link.AdminOnly)
                        {
                            <AuthorizeView Policy="@AdminPolicies.Administrator">
                                <NavLink class="dropdown-item" href="@link.Href" Match="@link.Match" @onclick="() => NavigationHistory.Clear()">@link.Caption()</NavLink>
                            </AuthorizeView>
                        }
                        else
                        {
                            <NavLink class="dropdown-item" href="@link.Href" Match="@link.Match" @onclick="() => NavigationHistory.Clear()">@link.Caption()</NavLink>
                        }
                    }
                </div>
            }
        }
    </div>
</li>
