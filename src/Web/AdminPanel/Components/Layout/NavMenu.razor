@using MUnique.OpenMU.Web.AdminPanel.Properties

<nav>
    <div class="top-row navbar">
        <button class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>

    <!-- Hiding it programmatically is not a good idea here, because we want to hide it based on the width of the device/window. -->
    <div class="nav-menu @NavMenuCssClass">
        @* The links are grouped into sections with a label instead of an icon per link. *@
        <ul class="nav flex-column">
            @if (this._isLoadingConfig)
            {
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="() => NavigationHistory.Clear()">@Resources.Loading</NavLink>
                </li>
            }
            else if (this._onlyShowSetup)
            {
                <li class="nav-section" role="presentation">@Resources.NavigationSystem</li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="setup" @onclick="() => NavigationHistory.Clear()">@Resources.Setup</NavLink>
                </li>
            }
            else
            {
                <li class="nav-section" role="presentation">@Resources.NavigationOverview</li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="() => NavigationHistory.Clear()">@Resources.Home</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="servers" @onclick="() => NavigationHistory.Clear()">@Resources.Servers</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="logged-in" @onclick="() => NavigationHistory.Clear()">@Resources.OnlineAccounts</NavLink>
                </li>
                <li class="nav-section" role="presentation">@Resources.NavigationPlayers</li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="accounts" @onclick="() => NavigationHistory.Clear()">@Resources.Accounts</NavLink>
                </li>
                <AuthorizeView Policy="@AdminPolicies.Administrator">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="account-manager" @onclick="() => NavigationHistory.Clear()">@Resources.AccountManagerTitle</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="item-packages" @onclick="() => NavigationHistory.Clear()">@Resources.ItemPackagesTitle</NavLink>
                    </li>
                </AuthorizeView>
                <li class="nav-item">
                    <NavLink class="nav-link" href="guilds" @onclick="() => NavigationHistory.Clear()">@Resources.Guilds</NavLink>
                </li>
                <li class="nav-item px-3">
                  <NavLink class="nav-link" href="leaderboards" @onclick="() => NavigationHistory.Clear()">
                    <span class="oi oi-badge" aria-hidden="true" /> @Resources.Leaderboards
                  </NavLink>
                </li>
                <AuthorizeView Policy="@AdminPolicies.Administrator">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="castle-siege" @onclick="() => NavigationHistory.Clear()">@Resources.CastleSiege</NavLink>
                    </li>
                </AuthorizeView>
                <li class="nav-section" role="presentation">@Resources.NavigationGame</li>
                @if (this.GameConfigurationId is { } gameConfigurationId)
                {
                    <ConfigNavMenu GameConfigurationId="@gameConfigurationId" />
                }
                <li class="nav-item">
                    <NavLink class="nav-link" href="config-updates" @onclick="() => NavigationHistory.Clear()">
                        @Resources.Updates
                        @if (this._availableConfigUpdates > 0)
                        {
                            <span class="badge text-bg-light ms-2">@this._availableConfigUpdates</span>
                            <span class="visually-hidden">@Resources.AvailableUpdates</span>
                        }
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="config-captions" @onclick="() => NavigationHistory.Clear()">@Resources.Captions</NavLink>
                </li>
                <li class="nav-section" role="presentation">@Resources.NavigationSystem</li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="setup" @onclick="() => NavigationHistory.Clear()">@Resources.Setup</NavLink>
                </li>
            }
            <AuthorizeView Policy="@AdminPolicies.Administrator">
                <li class="nav-item">
                    <NavLink class="nav-link" href="users" @onclick="() => NavigationHistory.Clear()">@Resources.Users</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="api-keys" @onclick="() => NavigationHistory.Clear()">@Resources.ApiKeys</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="audit" @onclick="() => NavigationHistory.Clear()">@Resources.ResourceManager.GetString("AuditHistory", Resources.Culture)</NavLink>
                </li>
            </AuthorizeView>
            @if (AdminPanelEnvironment.IsHostingEmbedded)
            {
                <li class="nav-item">
                    <NavLink class="nav-link" href="logfiles" @onclick="() => NavigationHistory.Clear()">@Resources.LogFiles</NavLink>
                </li>
                <AuthorizeView Policy="@AdminPolicies.Administrator">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="logging-configuration" @onclick="() => NavigationHistory.Clear()">@Resources.LoggingConfiguration</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="discord" @onclick="() => NavigationHistory.Clear()">@Resources.Discord</NavLink>
                    </li>
                </AuthorizeView>
            }
            @if (AdminPanelEnvironment.IsGrafanaAvailable)
            {
                <li class="nav-item">
                    <a class="nav-link" href="/grafana/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22loki%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22loki%22%2C%22uid%22%3A%22loki%22%7D%2C%22expr%22%3A%22%7Bservice_name%3D~%5C%22.%2B%5C%22%7D%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D"
                       target="_blank">
                        @Resources.Logs
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/grafana/dashboards"
                       target="_blank">
                        @Resources.Metrics
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/grafana/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22%7B%7D%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D"
                       target="_blank">
                        @Resources.Tracing
                    </a>
                </li>
            }
            @if (this.IsNetworkAnalyzerAvailable)
            {
                <li class="nav-item">
                    <NavLink class="nav-link" href="network-analyzer" @onclick="() => NavigationHistory.Clear()">@Resources.NetworkAnalyzer</NavLink>
                </li>
            }
        </ul>

        <ul class="nav flex-column nav-footer">
            <li class="nav-item">
                <CultureSelector />
            </li>
            <li class="nav-item">
                <a class="nav-link" href="https://munique.net" target="_blank">@Resources.About</a>
            </li>
        </ul>
    </div>
</nav>
