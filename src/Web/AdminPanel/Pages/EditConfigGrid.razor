@page "/edit-config-grid/{typeString}"

@using MUnique.OpenMU.DataModel
@using MUnique.OpenMU.Web.AdminPanel.Properties
@using Microsoft.AspNetCore.Components.QuickGrid

@if (this.Type is not null)
{
    var typeCaption = this.Type.GetPluralizedTypeCaption();
    <PageTitle>@typeCaption</PageTitle>
    <Breadcrumb Caption=@typeCaption IsFirstFromRoot="true"></Breadcrumb>
    <div class="page-header">
        <h1>@typeCaption</h1>
        <div class="page-actions">
            <button type="button" class="btn btn-primary btn-sm" @onclick="OnCreateButtonClickAsync"><span class="oi oi-plus" aria-hidden="true"></span> @Resources.AddNew</button>
        </div>
    </div>
}

@if (this.ViewModels is null)
{
    return;
}

<div class="page-toolbar">
    <div class="auto-form-search-group">
        <span class="oi oi-magnifying-glass search-icon" aria-hidden="true"></span>
        <input class="form-control" type="search" autofocus @bind="@NameFilter" @bind:event="oninput" placeholder="@Resources.Search ..."/>
    </div>
</div>

<div class="config-grid">
    <QuickGrid Items="@this.ViewModels" Pagination="@_pagination" Theme="none" >
        <PropertyColumn Title="@Resources.ConfigurationEntryName" Property="@(c => c.Name)" Sortable="true">
            <HeaderTemplate>
                <button type="button" class="col-title" onclick="@(() => context.Grid.SortByColumnAsync(context))">
                    <div class="col-title-text">@context.Title</div>
                    <div class="sort-indicator" aria-hidden="true"></div>
                </button>
            </HeaderTemplate>
        </PropertyColumn>
        <TemplateColumn Align="Align.End">
            @{
                var targetUrl = $"edit-config/{this.TypeString}/" + context.Id;
            }
            <div class="row-actions">
                <a href="@(targetUrl)" class="btn btn-outline-primary"><span class="oi oi-pencil" aria-hidden="true"></span> @Resources.Edit</a>
                <button type="button" class="btn btn-outline-secondary" title="@Resources.Duplicate" @onclick="@(() => this.OnDuplicateButtonClickAsync(context))"><span class="oi oi-layers" aria-hidden="true"></span><span class="d-none d-md-inline"> @Resources.Duplicate</span></button>
                <button type="button" class="btn btn-outline-danger" title="@Resources.Delete" @onclick="@(() => this.OnDeleteButtonClickAsync(context))"><span class="oi oi-trash" aria-hidden="true"></span><span class="d-none d-md-inline"> @Resources.Delete</span></button>
            </div>
        </TemplateColumn>
    </QuickGrid>
</div>
<LocalizedPaginator State="@_pagination" />
